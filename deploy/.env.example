# quevidkit server environment configuration
# Copy to .env, fill in real values, and point EnvironmentFile at it
# (see deploy/quevidkit.service).

# Directory where uploaded videos and analysis artifacts are stored.
# Default if unset: /tmp/quevidkit_uploads
QVK_UPLOAD_DIR=/opt/quevidkit/uploads

# Maximum accepted upload size, in bytes.
# Default if unset: 1073741824 (1 GiB)
QVK_MAX_UPLOAD_BYTES=1073741824

# How long (seconds) an uploaded video is retained before being purged.
# Default if unset: 86400 (24 hours)
QVK_UPLOAD_RETENTION_SECONDS=86400

# Set to 1 to disable automatic cleanup of uploaded files (debugging only).
# Default if unset: 0 (uploads are cleaned up per retention policy)
QVK_KEEP_UPLOADS=0

# How long (seconds) an issued session key remains valid.
# Default if unset: 3600 (1 hour)
QVK_SESSION_KEY_TTL_SECONDS=3600

# Max number of new session keys a client may generate within the
# generation window below.
# Default if unset: 10
QVK_SESSION_KEY_GEN_LIMIT=10

# Rolling window (seconds) that QVK_SESSION_KEY_GEN_LIMIT applies to.
# Default if unset: 3600 (1 hour)
QVK_SESSION_KEY_GEN_WINDOW_SECONDS=3600

# Max number of analysis jobs a single session key may create.
# Default if unset: 10
QVK_SESSION_KEY_JOB_LIMIT=10

# Secret used to sign/verify session keys.
# IMPORTANT: set this to a long, random value in any real deployment
# (e.g. `openssl rand -base64 48`). If left unset, the app falls back to
# an ephemeral random secret generated at process start — this keeps
# secrets out of the repo, but it also means every existing session key
# is invalidated on each restart and keys are not shared across workers.
# Do not leave this unset in production.
QVK_SESSION_KEY_SECRET=

# Comma-separated list of allowed CORS origins, e.g.
# https://example.com,https://app.example.com
# Default if unset/empty: "*" (all origins allowed)
QVK_CORS_ALLOW_ORIGINS=https://api.example.com
